# Required for Flask sessions and flash messages
SECRET_KEY=change-me-to-a-random-secret

# Required for the AI chat feature
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the default OpenRouter model
OPENROUTER_MODEL=openrouter/free

# Optional: provider metadata headers
OPENROUTER_HTTP_REFERER=http://localhost:5000
OPENROUTER_APP_TITLE=Investment Portfolio Tracker
