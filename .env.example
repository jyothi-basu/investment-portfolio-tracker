# Required for non-authentication web session data such as flash and CSRF messages
SECRET_KEY=change-me-to-a-random-secret
SESSION_COOKIE_SECURE=false

# JWT authentication. Generate JWT_SECRET_KEY with a cryptographically secure
# random generator and set both cookie flags to true behind production HTTPS.
JWT_SECRET_KEY=change-me-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=investment-portfolio-tracker
JWT_AUDIENCE=investment-portfolio-api
JWT_ACCESS_TOKEN_MINUTES=20
JWT_REFRESH_TOKEN_DAYS=7
JWT_COOKIE_SECURE=false

# AI provider configuration for the assistant and document classifier.
# Chat models support OpenAI-compatible providers and Gemini's native SDK.
# Embeddings support OpenAI-compatible providers or local SentenceTransformer models.
# For OpenAI-compatible providers, set the matching base URL too.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=

# Gemini example:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash
# LLM_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=

EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=your_api_key_here
EMBEDDINGS_BASE_URL=

# Local embedding example:
# EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=

# Legacy OpenAI-only names are still accepted as fallbacks if you already use them.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: server port if you choose to pass one to uvicorn
PORT=8000

# Required for the STDIO MCP document-search server
MCP_USER_ID=
MCP_CHAT_ID=
