# Copy this file to .env and replace every placeholder value.

# Application security
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
SESSION_COOKIE_SECURE=false

# Database
# PostgreSQL is the database currently used by this project.
DATABASE_URL=postgresql+psycopg://portfolio_user:password@localhost:5432/portfolio_tracker

# Test database
# Tests drop and recreate tables. Use a separate database, never DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://portfolio_user:password@localhost:5432/portfolio_tracker_test

# JWT authentication
JWT_SECRET_KEY=replace_with_a_different_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_ISSUER=investment-portfolio-tracker
JWT_AUDIENCE=investment-portfolio-api
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
JWT_COOKIE_SECURE=false

# Chat provider
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=replace_with_your_chat_provider_api_key
LLM_BASE_URL=

# Embedding provider
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=replace_with_your_embedding_provider_api_key
EMBEDDINGS_BASE_URL=

# Server
PORT=8000

# Optional local STDIO MCP conversation UUID
MCP_CONVERSATION_ID=

# MCP HTTP security allowlists for local development
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
